# Nexo local/Phase-1 infrastructure placeholders.
# Copy to `infra/.env` and fill with REAL values provided by the user.
# Never commit the populated .env — it contains secrets.

# Neon Postgres connection string used by the nexo-api container.
# Format: postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require
NEXO_DATABASE_URL=

# ngrok authtoken for the public HTTPS tunnel to nexo-api:3000.
NGROK_AUTHTOKEN=
